<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App shell theme. The in-app UI is Compose and uses HermesTheme (violet
         accent #7C5CFF). This style only sets the system chrome (status/nav bar)
         to match the brand so there is no flash of the wrong color on launch. -->
    <style name="Theme.Hermes" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7C5CFF</item>
        <item name="android:navigationBarColor">#0B0B10</item>
        <item name="android:statusBarColor">#0B0B10</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
