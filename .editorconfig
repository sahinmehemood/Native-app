root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
ij_kotlin_imports_layout = * # as needed
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{xml,json,yml,yaml}]
indent_size = 2
